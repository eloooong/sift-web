# Optional PostgreSQL persistence. Without this, the app uses in-memory stores.
DATABASE_URL=

# Optional AI-assisted message analysis.
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Optional URL reputation checks.
GOOGLE_SAFE_BROWSING_API_KEY=

# Set a long, random value to enable /reports/moderation.
MODERATION_TOKEN=

# Canonical URL for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
