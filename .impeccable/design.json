  "narrative": {
    "northStar": "The Public Safety Advisory",
    "overview": "Clear evidence and practical next steps carry the identity. Sift retains its approved Scout owl, Geist typography, cool slate palette, and functional risk colors, with a stronger typographic hierarchy and more generous task surfaces. The interface should feel calm, direct, and readable in the moments when a suspicious message creates pressure.\n\nThe redesign favors grouped content, open lists, and purposeful dividers over repeated decorative panels. Product truth and bilingual copy remain authoritative in PRODUCT.md and the dictionary. Page-specific composition is not a requirement for every future screen.",
    "keyCharacteristics": [
      "Cool slate backgrounds, white working surfaces, and near-black actions.",
      "Large sentence-case headings with readable explanations and form labels.",
      "Flat borders and tonal separation, without decorative shadows or glass.",
      "Semantic risk colors paired with text and an indicator.",
      "Visible content on arrival; interaction states carry the motion."
    ],
    "rules": [
      {
        "name": "The Colour Reserve Rule",
        "body": "Use non-neutral colors for risk, error, success, evidence, or data; never as unrelated decoration.",
        "section": "colors"
      },
      {
        "name": "The Semantic Foreground Rule",
        "body": "Tinted risk labels and highlighted evidence use the corresponding foreground token, not the brighter indicator color as small text. Pair the signal with a written label.",
        "section": "colors"
      },
      {
        "name": "The Reading Priority Rule",
        "body": "Explanations and task guidance use the readable body or small steps. Reserve reduced sizes for actual dense data and metadata.",
        "section": "typography"
      },
      {
        "name": "The Data Mono Rule",
        "body": "Monospace identifies evidence or measurements. Ordinary navigation, page headings, buttons, and form labels use Geist Sans.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Do not add drop shadows, glass effects, or gradient washes for decorative elevation. Use border and tonal changes for hover and selection.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the approved Scout owl and its reading lens in header and footer.",
      "**Do** keep essential explanations, labels, and touch controls readable before adding visual detail.",
      "**Do** use semantic foreground tokens for tinted risk labels in both themes.",
      "**Do** keep English and Filipino controls in the dictionary and allow labels to wrap when necessary.",
      "**Do** distinguish illustrative samples, research data, and a user's saved history.",
      "**Do** preserve visible focus, reduced-motion behavior, and logical mobile reading order."
    ],
    "donts": [
      "**Don't** use purple gradients, glassmorphism, decorative shadows, or AI-magic imagery.",
      "**Don't** use color as the only indication of risk or selection.",
      "**Don't** turn small chart typography into the default for form labels or instructions.",
      "**Don't** add uppercase eyebrow labels above headings or use monospace as a technical costume.",
      "**Don't** describe every legacy control as accessibility-verified solely because shared primitives meet the new target sizes."
    ]
  }
